<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VMS.Shared</RootNamespace>
    <AssemblyName>VMS.Shared</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.6.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The message catalogue: wording lives in this file, not in code (FSD 12.2). -->
    <!-- WithCulture=false: ".en." in the name would otherwise send it to a satellite assembly. -->
    <EmbeddedResource Include="Messages\messages.en.json" LogicalName="VMS.Shared.Messages.messages.en.json" WithCulture="false" />
  </ItemGroup>

</Project>
