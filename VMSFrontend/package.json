{
  "name": "vms-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prestart": "node scripts/check-no-hardcoded-colors.mjs",
    "build": "ng build",
    "prebuild": "node scripts/check-no-hardcoded-colors.mjs",
    "watch": "ng build --watch --configuration development",
    "check:colors": "node scripts/check-no-hardcoded-colors.mjs",
    "check:contrast": "node scripts/check-theme-contrast.mjs",
    "check:datetime": "node scripts/check-datetime.mjs",
    "check:access": "node --test scripts/check-access.test.mjs",
    "check:shared": "node --test scripts/check-shared.test.mjs",
    "check:partners": "node --test scripts/check-partners.test.mjs",
    "check:vehicles": "node --test scripts/check-vehicles.test.mjs",
    "test": "npm run check:access && npm run check:shared && npm run check:datetime && npm run check:partners && npm run check:vehicles"
  },
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@primeng/themes": "^19.1.4",
    "primeicons": "^7.0.0",
    "primeng": "^19.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "typescript": "~5.7.2"
  }
}
